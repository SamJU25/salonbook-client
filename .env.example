# Express Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-char-minimum-random-secret

# MongoDB (for Better Auth MongoDB Adapter)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/salonbook?retryWrites=true&w=majority

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
